<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BindablePropertyConcurrencyRepro.MainPage"
             Title="Element BP concurrency">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Element._pendingHandlerUpdatesFromBPSet race"
                   FontAttributes="Bold"
                   FontSize="17" />
            <Label x:Name="EnvironmentLabel" FontSize="11" />

            <!-- Holds the target element. Each run builds a *fresh* RaceLabel here rather than
                 reusing one: once a run has corrupted an element's internal state, that element
                 is unusable for a subsequent run. See MainPage.xaml.cs. -->
            <ContentView x:Name="TargetHost" />

            <Button x:Name="ButtonA"
                    Text="A — 2 threads, 2 custom BPs, no platform touch"
                    Clicked="OnRunA" />
            <Button x:Name="ButtonB"
                    Text="B — 1 off-thread GoToState vs UI-thread animation"
                    Clicked="OnRunB" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Stop" Clicked="OnStop" />
                <Button Text="Clear report" Clicked="OnClearReport" />
            </HorizontalStackLayout>

            <Label x:Name="StatusLabel" Text="idle" FontAttributes="Bold" FontSize="13" />
            <Label x:Name="DetailLabel" FontSize="10" LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
